{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "notique-background-recovery",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] }
}
