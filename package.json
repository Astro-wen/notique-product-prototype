{
  "name": "notique-evidence-poc",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "vite build --config vite.pages.config.ts",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/domain/domain.test.mjs tests/domain-invariants.test.mjs tests/eval-runner.test.mjs tests/export-production-run.test.mjs tests/merge-synthetic-transcript-ground-truth.test.mjs tests/migrations.test.mjs tests/multimodal-upload-policy.test.mjs tests/occurrence-conversion.test.mjs tests/repo-readiness.audit.mjs tests/rendered-html.test.mjs tests/synthetic-fixture-import.test.mjs",
    "test:domain": "node --test tests/domain/domain.test.mjs tests/domain-invariants.test.mjs",
    "test:audit": "node --test tests/repo-readiness.audit.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern pages-dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc --persist-to .wrangler/state",
    "eval": "node scripts/eval-runner.mjs",
    "eval:export-run": "node scripts/export-production-run.mjs",
    "eval:merge:synthetic-transcripts": "node scripts/merge-synthetic-transcript-ground-truth.mjs",
    "fixture:import": "node scripts/import-synthetic-fixture.mjs",
    "smoke:openai-multimodal": "node scripts/smoke-openai-multimodal.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
